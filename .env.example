# ── Required ────────────────────────────────────────────────────────────────
PICOVOICE_ACCESS_KEY=your_picovoice_access_key   # https://console.picovoice.ai/
WEATHER_API_KEY=your_weather_api_key             # https://www.weatherapi.com/

# ── LLM: any OpenAI-compatible server (LM Studio, llama.cpp, Ollama) ─────────
# The model must support tool/function calling (Llama 3.1+/3.2, Qwen 2.5+...).
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3-4b-2507   # Qwen3-4B-Instruct-2507; llama-3.2-3b-instruct also works
# LLM_API_KEY=local-placeholder
# LLM_TEMPERATURE=0.7
# LLM_HISTORY_TURNS=4            # recent exchanges sent per request (small models do better with few)
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5   # for searching notes; keyword search if absent

# ── Kitchen hazard monitoring ───────────────────────────────────────────────
CAMERA_ENABLED=false             # true once a camera is connected
CAMERA_SOURCE=0                  # webcam index, rtsp://... URL, video file, or an image folder for testing
# HAZARD_CHECK_INTERVAL_S=5
# VISION_CONFIDENCE=0.5
# STOVE_CONFIRM_FRAMES=3         # agreeing frames before the stove counts as on/off
# STOVE_UNATTENDED_MIN=10        # alert: stove on and nobody seen for this long
# STOVE_MAX_ON_MIN=90            # alert: stove on this long, even with people around
# HAZARD_REPEAT_MIN=5            # repeat alerts this often until resolved
# CAMERA_OFFLINE_ALERT_S=60
# SAVE_SNAPSHOTS=true            # jpg in config/snapshots/ for warnings and alerts only
# MAX_SNAPSHOTS=200

# ── Speech output ───────────────────────────────────────────────────────────
# TTS_VOLUME=1.0                 # 0-1 (also "set the volume to 6" by voice)
# QUIET_HOURS=22:00-07:00        # quieter non-urgent speech; empty to disable
# QUIET_VOLUME=0.4               # hazard alerts always play at full volume

# ── Optional tuning (defaults shown) ────────────────────────────────────────
# WEATHER_CACHE_MAX_AGE_H=6      # use saved weather this old if the service is down
# WAKE_WORD_SENSITIVITY=0.5      # 0-1, higher = more triggers and more false alarms
# WAKE_WORD_FALLBACK=jarvis      # built-in keyword when the custom .ppn can't load
# BARGE_IN_ENABLED=true          # say the wake word to interrupt the assistant
# BARGE_IN_GRACE_S=0.4           # ignore wake word this long after playback starts
# POST_TTS_DELAY_S=0.3
# STT_ENGINE=auto                # auto | whisper | vosk
# WHISPER_MODEL=base.en          # tiny.en | base.en | small.en
# WHISPER_DEVICE=cpu             # cpu | cuda
# WHISPER_COMPUTE=int8           # int8 (CPU) | float16 (GPU)
# VOSK_MODEL_PATH=AI_voice_assistant/STT_Model/vosk-model-small-en-us-0.15
# VAD_THRESHOLD=0.5
# VAD_END_SILENCE_S=0.8
# COMMAND_START_TIMEOUT_S=7
# COMMAND_MAX_S=15
# TTS_VOICE_PATH=AI_voice_assistant/voices/en_GB-cori-medium.onnx
